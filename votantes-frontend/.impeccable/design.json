  "components": [
    {
      "name": "Botón principal",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "La acción principal de cada pantalla, arriba a la derecha, en el color de la campaña.",
      "html": "<button class=\"ds-btn-primario\" style=\"--campana:#00607A\">Nuevo votante</button>",
      "css": ".ds-btn-primario{display:inline-flex;align-items:center;gap:8px;height:44px;padding:0 16px;border:0;border-radius:6px;font-family:var(--font-sans,\"Figtree Variable\",Figtree,system-ui,sans-serif);font-size:15px;font-weight:620;white-space:nowrap;cursor:pointer;transition:transform 150ms cubic-bezier(0.23,1,0.32,1),background-color 150ms cubic-bezier(0.23,1,0.32,1),filter 150ms cubic-bezier(0.23,1,0.32,1);background:var(--campana,#121417);color:#fff;box-shadow:0 1px 2px rgb(18 20 23/0.18);}.ds-btn-primario:hover{filter:brightness(1.08);}.ds-btn-primario:active{transform:scale(0.97);}.ds-btn-primario:focus-visible{outline:2px solid var(--campana,#121417);outline-offset:2px;}"
    },
    {
      "name": "Botón secundario",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Exportar, cancelar y paginar: papel con contorno de filete fuerte.",
      "html": "<button class=\"ds-btn-secundario\">Exportar PDF</button>",
      "css": ".ds-btn-secundario{display:inline-flex;align-items:center;gap:8px;height:44px;padding:0 16px;border:0;border-radius:6px;font-family:var(--font-sans,\"Figtree Variable\",Figtree,system-ui,sans-serif);font-size:15px;font-weight:620;white-space:nowrap;cursor:pointer;transition:transform 150ms cubic-bezier(0.23,1,0.32,1),background-color 150ms cubic-bezier(0.23,1,0.32,1),filter 150ms cubic-bezier(0.23,1,0.32,1);background:#fff;color:#121417;box-shadow:inset 0 0 0 1px #b9b6ae;}.ds-btn-secundario:hover{background:#f2f2ef;}.ds-btn-secundario:active{transform:scale(0.97);}.ds-btn-secundario:focus-visible{outline:2px solid var(--campana,#121417);outline-offset:2px;}"
    },
    {
      "name": "Eliminar en fila",
      "kind": "button",
      "refersTo": "button-danger-quiet",
      "description": "Ícono rojo discreto, último en la fila y separado 16px de editar.",
      "html": "<button class=\"ds-btn-eliminar\" aria-label=\"Eliminar\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 16 16\" fill=\"currentColor\" aria-hidden=\"true\"><path d=\"M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0z\"/><path d=\"M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1 0-2H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1M4 4v9a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4z\"/></svg></button>",
      "css": ".ds-btn-eliminar{display:inline-flex;align-items:center;justify-content:center;width:40px;height:40px;border:0;border-radius:6px;background:transparent;color:#b42318;cursor:pointer;transition:background-color 150ms cubic-bezier(0.23,1,0.32,1),transform 150ms cubic-bezier(0.23,1,0.32,1);}.ds-btn-eliminar:hover{background:#fbe7e4;box-shadow:inset 0 0 0 1px rgb(180 35 24/0.45);}.ds-btn-eliminar:active{transform:scale(0.97);}.ds-btn-eliminar:focus-visible{outline:2px solid var(--campana,#121417);outline-offset:2px;}"
    },
    {
      "name": "Campo",
      "kind": "input",
      "refersTo": "input",
      "description": "Etiqueta arriba, control de 44px, foco en color de campaña.",
      "html": "<div class=\"ds-campo\" style=\"--campana:#00607A\"><label class=\"ds-campo-etiqueta\" for=\"ds-c\">Cédula</label><input id=\"ds-c\" class=\"ds-campo-control\" placeholder=\"Ej. 1067845123\"><p class=\"ds-campo-ayuda\">Sin puntos ni espacios.</p></div>",
      "css": ".ds-campo{font-family:var(--font-sans,\"Figtree Variable\",Figtree,system-ui,sans-serif);color:#121417;max-width:320px;}.ds-campo-etiqueta{display:block;margin-bottom:6px;font-size:14px;font-weight:620;}.ds-campo-control{display:block;width:100%;height:44px;padding:0 12px;border:0;border-radius:6px;background:#fff;color:#121417;font:inherit;font-size:16px;box-shadow:inset 0 0 0 1px #b9b6ae;caret-color:var(--campana,#121417);transition:box-shadow 150ms;}.ds-campo-control::placeholder{color:#5f646c;}.ds-campo-control:focus{outline:none;box-shadow:inset 0 0 0 2px var(--campana,#121417);}.ds-campo-ayuda{margin:6px 0 0;font-size:13px;color:#5f646c;}"
    },
    {
      "name": "Pendón",
      "kind": "nav",
      "refersTo": "pendon",
      "description": "Navegación en el color de la campaña con el aspirante principal en titular de peso 800; la opción activa se invierte.",
      "html": "<aside class=\"ds-pendon\" style=\"--campana:#00607A\"><p class=\"ds-pendon-nombre\">Alcalde Prueba</p><p class=\"ds-pendon-campana\">Alcaldía de prueba</p><p class=\"ds-pendon-territorio\">Alcaldía · Montería, Córdoba</p><nav><a class=\"ds-pendon-op ds-activa\" href=\"#\">Resumen</a><a class=\"ds-pendon-op\" href=\"#\">Líderes</a><a class=\"ds-pendon-op\" href=\"#\">Votantes</a></nav></aside>",
      "css": ".ds-pendon{font-family:var(--font-sans,\"Figtree Variable\",Figtree,system-ui,sans-serif);width:264px;padding:28px 20px 20px;background:var(--campana,#121417);color:#fff;animation:ds-izar 450ms cubic-bezier(0.32,0.72,0,1) both;}@keyframes ds-izar{from{clip-path:inset(0 0 100% 0)}to{clip-path:inset(0)}}.ds-pendon-nombre{margin:0;font-size:2.125rem;font-weight:800;letter-spacing:-0.025em;line-height:0.88;text-transform:uppercase;}.ds-pendon-campana{margin:12px 0 0;font-size:15px;font-weight:650;}.ds-pendon-territorio{margin:4px 0 32px;font-size:13px;font-weight:520;color:rgb(255 255 255/0.8);}.ds-pendon nav{display:flex;flex-direction:column;gap:2px;}.ds-pendon-op{display:flex;align-items:center;height:44px;padding:0 12px;border-radius:6px;font-size:15px;font-weight:620;color:rgb(255 255 255/0.88);text-decoration:none;transition:background-color 150ms,color 150ms;}.ds-pendon-op:hover{background:rgb(255 255 255/0.12);color:#fff;}.ds-pendon-op.ds-activa{background:#fff;color:var(--campana,#121417);}.ds-pendon-op:focus-visible{outline:2px solid #fff;outline-offset:2px;}@media (prefers-reduced-motion:reduce){.ds-pendon{animation:none}}"
    },
    {
      "name": "Cifras titulares",
      "kind": "custom",
      "refersTo": "cifras-celda",
      "description": "Fila de cifras en tinta separadas por filetes; encabeza cada pantalla con números.",
      "html": "<dl class=\"ds-cifras\"><div><dt>Votantes</dt><dd class=\"ds-cifra\">1.284</dd></div><div><dt>Líderes activos</dt><dd class=\"ds-cifra\">37</dd><dd class=\"ds-detalle\">con al menos un votante</dd></div><div><dt>Asistieron</dt><dd class=\"ds-cifra\">642</dd><dd class=\"ds-detalle\">50 % de los votantes</dd></div></dl>",
      "css": ".ds-cifras{font-family:var(--font-sans,\"Figtree Variable\",Figtree,system-ui,sans-serif);display:grid;grid-template-columns:repeat(auto-fit,minmax(11rem,1fr));gap:1px;margin:0;overflow:hidden;border-radius:8px;background:#dedcd6;box-shadow:0 0 0 1px #dedcd6;color:#121417;}.ds-cifras>div{display:flex;flex-direction:column;background:#fff;padding:20px;}.ds-cifras dt{font-size:0.75rem;font-weight:650;letter-spacing:0.06em;text-transform:uppercase;color:#5f646c;}.ds-cifra{margin:12px 0 0;font-size:3.5rem;font-weight:800;letter-spacing:-0.03em;line-height:0.95;font-variant-numeric:tabular-nums lining-nums;}.ds-detalle{margin:8px 0 0;font-size:13px;color:#3d4148;}"
    },
    {
      "name": "Tabla con filetes",
      "kind": "card",
      "refersTo": "tabla-encabezado",
      "description": "Papel con filete, encabezados en rótulo, filas separadas por filete, sin cebra.",
      "html": "<div class=\"ds-tabla\"><table><thead><tr><th>Votante</th><th>Líder</th><th>Aspirante</th></tr></thead><tbody><tr><td><b>Votante 1</b><br><small>C.C. 9.970.843.034</small></td><td>Líder de A</td><td>Concejal A</td></tr><tr><td><b>Votante 2</b><br><small>C.C. 99.708.430.341</small></td><td>Sin líder</td><td>Concejal B</td></tr></tbody></table></div>",
      "css": ".ds-tabla{font-family:var(--font-sans,\"Figtree Variable\",Figtree,system-ui,sans-serif);overflow:hidden;border-radius:8px;background:#fff;box-shadow:0 0 0 1px #dedcd6;color:#121417;}.ds-tabla table{width:100%;border-collapse:collapse;font-size:15px;}.ds-tabla th{padding:12px 16px;text-align:left;border-bottom:1px solid #b9b6ae;font-size:0.75rem;font-weight:650;letter-spacing:0.06em;text-transform:uppercase;color:#5f646c;white-space:nowrap;}.ds-tabla td{padding:12px 16px;border-bottom:1px solid #dedcd6;}.ds-tabla tbody tr:last-child td{border-bottom:0;}.ds-tabla tbody tr{transition:background-color 150ms;}.ds-tabla tbody tr:hover{background:rgb(242 242 239/0.7);}.ds-tabla b{font-weight:650;}.ds-tabla small{font-size:13px;color:#5f646c;}"
    },
